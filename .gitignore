# ---------------------------------------------------------------------------
# Python 运行产物
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python

# 打包 / 安装产物
build/
build-temp/          # packaging\build.bat 的 --workpath
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/
MANIFEST
*.manifest

# 虚拟环境
.venv/
venv/
env/
ENV/

# 测试与工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ---------------------------------------------------------------------------
# PyInstaller
#   只忽略自动生成的 spec；build.spec 是本项目手写的打包配置，必须入库。
# ---------------------------------------------------------------------------
*.spec
!build.spec

# ---------------------------------------------------------------------------
# 本机构建环境（便携 Python 3.8 + 离线 wheel，体积大且可重建，不入库）
# ---------------------------------------------------------------------------
build-env/

# ---------------------------------------------------------------------------
# 下载产物与本机调试残留
# ---------------------------------------------------------------------------
MediaFireDownloads/
downloads/
*.part
*.part.tmp
.mfd_hist_*

# 自检/调试期间的数据目录与临时解压目录（程序正常运行不会在工作区里造这些）
.testdata/
.runtmp/

# 交付物目录：exe 与源码 zip 属于构建产物，走 GitHub Releases，不入库
dist-package/

# 打包日志（每次构建都会重新生成）
packaging/build-log.txt

# 界面截图的早期尝试：PrintWindow 抓不到 Tk 自绘控件，产物是伪影，不作为素材入库
docs/screenshots/
tools/capture_ui.py

# 打包调试副本（build-debug.spec 生成）
dist-dbg/
build-temp-dbg/

# 定位启动问题时留下的分步探针与日志
step_check*.py
step*.log
step*.err.txt
step*.out.txt
selftest.err.txt
mfd-probe-*/
mfd-save-*/

# ---------------------------------------------------------------------------
# 编辑器 / 系统
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

dist-dir/
build-temp-dir/

# 调试用的临时裁剪图/截图，绝不上传
.crop-*.png
*.crop.png

# 本地调试残留（不进仓库）
_repro.py
build-log-*.txt
step*.log

# 本地一次性脚本与提交信息
.git-msg.txt
_pack*.py
_bump*.py

# 下划线前缀是本项目的一次性调试脚本约定（_row_check.py、_probe_dl.py 之类），
# 一律不入库；测试用的真材料都在 tests/ 下，不受影响。
_*.py
_*.png
_*.log
_*.txt
!_*.md

# 测试残留（Settings 隔离目录、临时下载目录）
mfd_settings_*/
tmp*/
.testdata/
_disc.*.txt
_build.*.txt
